<%- include('partials/header', { title: 'New Post' }) %>

<div class="form-page">
  <div class="form-page-back">
    <a href="/" class="back-link">← Back</a>
  </div>

  <div class="form-container">
    <div class="form-header">
      <span class="form-eyebrow">Create</span>
      <h1 class="form-title">New Post</h1>
    </div>

    <form action="/posts" method="POST" class="post-form">
      <div class="form-group">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          class="form-input"
          placeholder="Give your post a title…"
          required
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label for="author" class="form-label">Author</label>
        <input
          type="text"
          id="author"
          name="author"
          class="form-input"
          placeholder="Your name (optional)"
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label for="content" class="form-label">Content</label>
        <textarea
          id="content"
          name="content"
          class="form-textarea"
          placeholder="Start writing…"
          rows="16"
          required
        ></textarea>
        <span class="form-hint">Separate paragraphs with a blank line.</span>
      </div>

      <div class="form-actions">
        <a href="/" class="btn-ghost">Cancel</a>
        <button type="submit" class="btn-primary">Publish Post</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
