<%- include('partials/header', { title: 'Edit Post' }) %>

<div class="form-page">
  <div class="form-page-back">
    <a href="/posts/<%= post.id %>" class="back-link">← Back to post</a>
  </div>

  <div class="form-container">
    <div class="form-header">
      <span class="form-eyebrow">Editing</span>
      <h1 class="form-title">Update Post</h1>
    </div>

    <form action="/posts/<%= post.id %>/update" method="POST" class="post-form">
      <div class="form-group">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          id="title"
          name="title"
          class="form-input"
          value="<%= post.title %>"
          required
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label for="author" class="form-label">Author</label>
        <input
          type="text"
          id="author"
          name="author"
          class="form-input"
          value="<%= post.author %>"
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label for="content" class="form-label">Content</label>
        <textarea
          id="content"
          name="content"
          class="form-textarea"
          rows="16"
          required
        ><%= post.content %></textarea>
        <span class="form-hint">Separate paragraphs with a blank line.</span>
      </div>

      <div class="form-actions">
        <a href="/posts/<%= post.id %>" class="btn-ghost">Cancel</a>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
